{
  "name": "dmarcas",
  "version": "1.0.0",
  "description": "Catálogo web moderno, interactivo y optimizado para móviles diseñado para **Diversas Marcas**, boutique multimarca ubicada en **Tepic, Nayarit, México**.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "setup:admin": "node scripts/setup-admin.mjs",
    "admin:credentials": "node scripts/show-admin-credentials.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "animejs": "^4.5.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
